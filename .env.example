# Copy to .env and fill in when real credentials are available.
# Leave unset to use the in-memory mock implementations.

# Vector DB (Pinecone) — leave unset to use MockVectorStore
PINECONE_API_KEY=
PINECONE_INDEX_NAME=agentic-rag

# Graph DB (Neo4j AuraDB) — leave unset to use MockGraphStore
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# LLM provider for LangGraph nodes (any LiteLLM/LangChain-supported provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
